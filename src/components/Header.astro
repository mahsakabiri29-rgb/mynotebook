---
// سربرگ سایت: نام دفترچه + ناوبری اصلی + جستجو
import { SITE, SECTIONS } from '../config';

const nav = [
  { href: '/', label: 'خانه' },
  { href: SECTIONS.everyone.href, label: SECTIONS.everyone.title },
  { href: SECTIONS.professionals.href, label: SECTIONS.professionals.title },
  { href: '/notebook', label: 'دفترچهٔ یادگیری' },
  { href: '/about', label: 'درباره' },
];

const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);
---

<header class="masthead">
  <div class="container inner">
    <a class="brand" href="/">{SITE.name}</a>
    <nav aria-label="ناوبری اصلی">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={{ active: isActive(item.href) }}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <form class="search suggest-wrap" action="/search" role="search">
      <svg class="s-icon" viewBox="0 0 20 20" aria-hidden="true">
        <circle cx="9" cy="9" r="6" fill="none" stroke="currentColor" stroke-width="2" />
        <line x1="13.5" y1="13.5" x2="18" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
      <input
        type="search"
        name="q"
        data-suggest
        placeholder="جستجو…"
        aria-label="جستجو در یادداشت‌ها"
        autocomplete="off"
      />
    </form>
  </div>
</header>

<script>
  import '../scripts/search-suggest';
</script>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-block-end: 1px solid var(--line);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.4rem;
    padding-block: 0.9rem;
  }

  .brand {
    font-size: 1.12rem;
    font-weight: 800;
    color: var(--ink);
    text-decoration: none;
  }

  .brand:hover {
    color: var(--accent);
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    color: var(--ink-soft);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    padding-block: 0.2rem;
  }

  nav a:hover {
    color: var(--ink);
  }

  nav a.active {
    color: var(--accent);
    font-weight: 700;
  }

  .search {
    margin-inline-start: auto;
    flex: 0 1 15rem;
  }

  .search .s-icon {
    position: absolute;
    inset-inline-start: 0.85rem;
    top: 50%;
    translate: 0 -50%;
    inline-size: 1rem;
    block-size: 1rem;
    color: var(--ink-faint);
    pointer-events: none;
    transition: color 0.2s ease;
  }

  .search input {
    font: inherit;
    font-size: 0.9rem;
    color: var(--ink);
    background: var(--wash);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding-block: 0.38em;
    padding-inline: 2.6em 1.1em;
    inline-size: 100%;
    outline: none;
    transition:
      border-color 0.2s ease,
      background 0.2s ease,
      box-shadow 0.2s ease;
  }

  .search input::placeholder {
    color: var(--ink-faint);
  }

  .search input:focus {
    border-color: var(--accent);
    background: var(--paper);
    box-shadow: 0 0 0 4px var(--accent-wash);
  }

  .search:focus-within .s-icon {
    color: var(--accent);
  }

  @media (max-width: 48rem) {
    .search {
      order: 3;
      flex-basis: 100%;
    }
  }
</style>
