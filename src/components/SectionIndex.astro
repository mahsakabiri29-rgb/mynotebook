---
// صفحهٔ فهرست هر بخش: سرصفحهٔ بخش + فهرست مقاله‌ها
import { getCollection } from 'astro:content';
import ArticleCard from './ArticleCard.astro';
import { SECTIONS, type SectionKey } from '../config';

interface Props {
  section: SectionKey;
}

const { section } = Astro.props;
const meta = SECTIONS[section];
const posts = (await getCollection(section, (p) => !p.data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<section class="section-page container">
  <header class="head">
    <p class="kicker">{meta.kicker}</p>
    <h1>{meta.title}</h1>
    <p class="intro">{meta.intro}</p>
  </header>

  <div class="list">
    {posts.map((post) => <ArticleCard post={post} showKicker={false} />)}
    {posts.length === 0 && <p class="empty">هنوز مقاله‌ای در این بخش منتشر نشده است.</p>}
  </div>
</section>

<style>
  .section-page {
    max-inline-size: 58rem;
    padding-block-start: clamp(3rem, 8vh, 4.5rem);
  }

  .head h1 {
    font-size: clamp(2rem, 1.5rem + 2.4vw, 2.9rem);
    font-weight: 800;
    margin-block-end: 0.9rem;
  }

  .intro {
    color: var(--ink-soft);
    max-inline-size: 36rem;
    font-size: 1.05rem;
  }

  .list {
    margin-block-start: 2.25rem;
    padding-block-end: 3rem;
  }

  .empty {
    color: var(--ink-faint);
    padding-block: 2rem;
  }
</style>
