---
// خلاصهٔ صوتی فصل (ویس فارسی) — پخش با Web Speech API مرورگر
// متن از فیلد voiceSummary فرانت‌مترِ فصل می‌آید؛ بهترین صدا: voice فارسی
// (در ویندوز/Edge بهترین نتیجه؛ اگر voice فارسی نبود، هشدار می‌دهد)
interface Props {
  text: string;
  label?: string;
}
const { text, label = 'خلاصهٔ صوتی فصل — ویس فارسی' } = Astro.props;
---

<div class="voice" data-voice>
  <div class="v-head">
    <svg viewBox="0 0 24 24" aria-hidden="true" class="v-icon">
      <path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor" />
      <path d="M16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
    </svg>
    <span class="v-title">{label}</span>
  </div>
  <div class="v-controls">
    <button type="button" class="v-play" aria-label="پخش خلاصهٔ صوتی">▶ پخش</button>
    <button type="button" class="v-stop" aria-label="توقف" disabled>■ توقف</button>
    <label class="v-rate">
      سرعت
      <select class="v-rate-sel" aria-label="سرعت پخش">
        <option value="0.85">آهسته</option>
        <option value="1" selected>معمولی</option>
        <option value="1.15">تند</option>
      </select>
    </label>
  </div>
  <p class="v-status" hidden></p>
  <div class="vtext" hidden>{text}</div>
</div>

<script>
  // پخش‌کنندهٔ ویس — برای هر .voice روی صفحه
  const cards = document.querySelectorAll<HTMLElement>('.voice[data-voice]');

  function pickVoice(): SpeechSynthesisVoice | null {
    const vs = speechSynthesis.getVoices();
    if (vs.length === 0) return null;
    const fa = vs.filter((v) => v.lang?.toLowerCase().startsWith('fa'));
    if (fa.length > 0) {
      // ترجیح: صداهای Natural/Online (Edge) بعد Dilara/Farid
      return (
        fa.find((v) => /natural|online/i.test(v.name)) ??
        fa.find((v) => /dilara|farid/i.test(v.name)) ??
        fa[0]
      );
    }
    return null;
  }

  cards.forEach((card) => {
    const text = (card.querySelector('.vtext') as HTMLElement)?.textContent?.trim() ?? '';
    if (!text) return;

    const playBtn = card.querySelector('.v-play') as HTMLButtonElement;
    const stopBtn = card.querySelector('.v-stop') as HTMLButtonElement;
    const rateSel = card.querySelector('.v-rate-sel') as HTMLSelectElement;
    const status = card.querySelector('.v-status') as HTMLElement;

    let playing = false;

    const showStatus = (msg: string) => {
      status.hidden = false;
      status.textContent = msg;
    };

    const setUI = (on: boolean) => {
      playing = on;
      playBtn.textContent = on ? '❚❚ در حال پخش…' : '▶ پخش';
      playBtn.setAttribute('aria-label', on ? 'مکث' : 'پخش خلاصهٔ صوتی');
      stopBtn.disabled = !on;
    };

    const speak = () => {
      speechSynthesis.cancel();
      const u = new SpeechSynthesisUtterance(text);
      const v = pickVoice();
      if (v) u.voice = v;
      u.lang = 'fa-IR';
      u.rate = parseFloat(rateSel.value) || 1;
      u.onend = () => setUI(false);
      u.onerror = () => {
        setUI(false);
        showStatus('پخش متوقف شد.');
      };
      speechSynthesis.speak(u);
      setUI(true);
      if (v) showStatus(`صدا: ${v.name}`);
      else
        showStatus(
          'صدای فارسی در این مرورگر پیدا نشد؛ با بهترین صدای موجود پخش می‌شود. برای ویس طبیعی‌تر از Microsoft Edge باز کنید.'
        );
    };

    playBtn.addEventListener('click', () => {
      if (playing) {
        speechSynthesis.cancel();
        setUI(false);
      } else {
        speak();
      }
    });

    stopBtn.addEventListener('click', () => {
      speechSynthesis.cancel();
      setUI(false);
    });

    // صداهای Edge بعد از voiceschanged لود می‌شوند
    speechSynthesis.addEventListener?.('voiceschanged', () => {}, { once: true });
  });
</script>

<style>
  .voice {
    --p-petrol: #0f3a4a;
    --p-blue: #5d8dab;
    --p-beige: #f3ecdf;
    --p-line: #d9d2c2;
    margin-block: 1.4rem 0.4rem;
    background: var(--p-beige);
    border: 1px solid var(--p-line);
    border-inline-start: 4px solid var(--p-petrol);
    border-radius: 12px;
    padding: 1rem 1.2rem;
  }

  .v-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-block-end: 0.8rem;
  }

  .v-icon {
    inline-size: 1.5rem;
    block-size: 1.5rem;
    color: var(--p-petrol);
    flex: none;
  }

  .v-title {
    font-weight: 800;
    color: var(--p-petrol);
    font-size: 0.98rem;
  }

  .v-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  .v-play,
  .v-stop {
    font: inherit;
    font-size: 0.88rem;
    font-weight: 700;
    border: none;
    border-radius: 999px;
    padding: 0.35em 1.25em;
    cursor: pointer;
    transition:
      background 0.2s ease,
      color 0.2s ease,
      opacity 0.2s ease;
  }

  .v-play {
    background: var(--p-petrol);
    color: #fff;
  }

  .v-play:hover {
    background: #0a2a37;
  }

  .v-stop {
    background: #ffffff;
    color: var(--p-petrol);
    border: 1px solid var(--p-line);
  }

  .v-stop:disabled {
    opacity: 0.45;
    cursor: default;
  }

  .v-rate {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    color: var(--p-petrol);
    font-weight: 600;
    margin-inline-start: auto;
  }

  .v-rate-sel {
    font: inherit;
    font-size: 0.82rem;
    border: 1px solid var(--p-line);
    border-radius: 8px;
    padding: 0.25em 0.6em;
    background: #fff;
    color: var(--p-petrol);
  }

  .v-status {
    margin-block-start: 0.7rem;
    font-size: 0.8rem;
    color: #5b6472;
    line-height: 1.8;
  }
</style>
