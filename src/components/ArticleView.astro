---
// نمایش یک یادداشت/مقاله: سرصفحه + متن + نشان نوع + مقالهٔ مرجع + منابع + سابقهٔ تغییرات
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SECTIONS, NOTE_KINDS, type SectionKey, type NoteKind } from '../config';
import { faDate, readingMinutes, toFa } from '../lib/format';

interface Props {
  post: CollectionEntry<'everyone' | 'professionals' | 'failsafe' | 'notebook'>;
}

const { post } = Astro.props;
const isNotebook = post.collection === 'notebook';
const section = isNotebook ? null : SECTIONS[post.collection as SectionKey];
const kindLabel = NOTE_KINDS[post.data.kind as NoteKind];
const { Content } = await render(post);
const minutes = readingMinutes(post.body ?? '');
const backHref = isNotebook ? '/notebook' : section!.href;
const backLabel = isNotebook ? 'دفترچهٔ یادگیری' : section!.title;
---

<Base title={`${post.data.title} — `} description={post.data.description}>
  <article class="article container">
    <header class="head">
      <p class="kicker">
        {isNotebook ? <span class="kind-badge">{kindLabel}</span> : section!.title}
        {post.data.kind !== 'article' && !isNotebook && (
          <span class="kind-badge spaced">{kindLabel}</span>
        )}
      </p>
      <h1>{post.data.title}</h1>
      {post.data.description && <p class="dek">{post.data.description}</p>}
      <p class="meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {faDate(post.data.pubDate)}
        </time>
        <span aria-hidden="true">·</span>
        <span>{toFa(minutes)} دقیقه مطالعه</span>
        {
          post.data.updated && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                به‌روزشده:{' '}
                <time datetime={post.data.updated.toISOString()}>
                  {faDate(post.data.updated)}
                </time>
              </span>
            </>
          )
        }
      </p>
      {
        post.data.paper && (
          <p class="paper" dir="ltr">
            <strong>Source paper:</strong> {post.data.paper}
          </p>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>

    {
      post.data.references.length > 0 && (
        <section class="refs" aria-label="منابع">
          <h2>منابع</h2>
          <ol>
            {post.data.references.map((ref) => (
              <li dir="ltr">{ref}</li>
            ))}
          </ol>
        </section>
      )
    }

    {
      post.data.changelog.length > 0 && (
        <section class="changelog" aria-label="سابقهٔ تغییرات">
          <h2>سابقهٔ این یادداشت</h2>
          <ul>
            {post.data.changelog.map((c) => (
              <li>
                <time datetime={c.date.toISOString()}>{faDate(c.date)}</time> — {c.note}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <p class="back">
      <a href={backHref}>بازگشت به {backLabel}</a>
    </p>
  </article>
</Base>

<style>
  .article {
    max-inline-size: calc(var(--prose) + 2 * var(--gutter));
  }

  .head {
    padding-block: clamp(3rem, 8vh, 4.25rem) 2.25rem;
  }

  .head h1 {
    font-size: clamp(1.8rem, 1.35rem + 2.2vw, 2.7rem);
    font-weight: 800;
  }

  .dek {
    margin-block: 1rem 1.35rem;
    font-size: 1.12rem;
    color: var(--ink-soft);
    line-height: 1.9;
  }

  .meta {
    padding-block-end: 2.5rem;
    border-block-end: 1px solid var(--line);
    margin-block-end: 2.5rem;
  }

  .kind-badge.spaced {
    margin-inline-start: 0.6rem;
  }

  .paper {
    font-size: 0.85rem;
    color: var(--ink-soft);
    background: var(--wash);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 0.7em 1em;
    margin-block-start: 1.4rem;
    text-align: left;
    line-height: 1.8;
  }

  .refs h2,
  .changelog h2 {
    font-size: 1.05rem;
    margin-block: 2.5rem 0.7rem;
  }

  .refs ol {
    padding-inline-start: 1.6em;
    font-size: 0.85rem;
    color: var(--ink-soft);
    line-height: 1.9;
    text-align: left;
  }

  .changelog ul {
    list-style: none;
    padding: 0;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .changelog li + li {
    margin-block-start: 0.5em;
  }

  .back {
    margin-block: 3rem;
    font-size: 0.95rem;
  }
</style>
