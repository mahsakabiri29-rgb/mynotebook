---
// کارت یادداشت در فهرست‌ها: نشان بخش/نوع، عنوان، خلاصه، تاریخ و زمان مطالعه
import type { CollectionEntry } from 'astro:content';
import { SECTIONS, NOTE_KINDS, type SectionKey, type NoteKind } from '../config';
import { faDate, readingMinutes, toFa } from '../lib/format';

interface Props {
  post: CollectionEntry<'everyone' | 'professionals' | 'failsafe' | 'notebook'>;
  showKicker?: boolean;
}

const { post, showKicker = true } = Astro.props;
const isNotebook = post.collection === 'notebook';

const href = isNotebook
  ? `/notebook/${post.id}`
  : `${SECTIONS[post.collection as SectionKey].href}/${post.id}`;

const kickerLabel = isNotebook
  ? NOTE_KINDS[post.data.kind as NoteKind]
  : SECTIONS[post.collection as SectionKey].title;

const minutes = readingMinutes(post.body ?? '');
---

<article class="entry">
  {
    showKicker && (
      <p class="kicker">
        {isNotebook ? <span class="kind-badge">{kickerLabel}</span> : kickerLabel}
      </p>
    )
  }
  <h3 class="title">
    <a href={href}>{post.data.title}</a>
  </h3>
  {post.data.description && <p class="dek">{post.data.description}</p>}
  <p class="meta">
    <time datetime={post.data.pubDate.toISOString()}>
      {faDate(post.data.pubDate)}
    </time>
    <span aria-hidden="true">·</span>
    <span>{toFa(minutes)} دقیقه مطالعه</span>
  </p>
</article>

<style>
  .entry {
    padding-block: 1.5rem;
  }

  /* بین کارت‌های پشت‌سرهم یک خط مویی می‌افتد */
  .entry + .entry {
    border-block-start: 1px solid var(--line);
  }

  .title {
    font-size: 1.2rem;
    margin-block: 0.15rem 0.5rem;
  }

  .title a {
    color: var(--ink);
    text-decoration: none;
  }

  .title a:hover {
    color: var(--accent);
  }

  .dek {
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.9;
    margin-block-end: 0.7rem;
  }
</style>
