---
// پاورقی سایت: نویسنده + هویت دفترچه + یادداشت حقوقی آموزشی
import { SITE } from '../config';
import { faYear } from '../lib/format';
---

<footer class="site-footer">
  <div class="container inner">
    <div class="identity">
      <p class="name">{SITE.author.name}</p>
      <p class="role">{SITE.author.title}</p>
      <p class="tagline">{SITE.tagline}</p>
    </div>
    <div class="colophon">
      <p class="note">
        محتوای این دفترچه صرفاً یادداشت یادگیری و مقاصد آموزشی است؛ جایگزین معاینه، تشخیص و مشاورهٔ دندان‌پزشک نیست.
      </p>
      <p class="copy">© {faYear()} {SITE.author.name}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-block-start: 1px solid var(--line);
    margin-block-start: 5rem;
  }

  .inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding-block: 2.75rem;
  }

  @media (min-width: 720px) {
    .inner {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }

    .colophon {
      text-align: end;
    }
  }

  .name {
    font-weight: 800;
    font-size: 1.05rem;
  }

  .role {
    color: var(--accent);
    font-size: 0.9rem;
    margin-block-start: 0.2rem;
  }

  .tagline {
    color: var(--ink-soft);
    font-size: 0.92rem;
    margin-block-start: 0.45rem;
  }

  .note {
    color: var(--ink-faint);
    font-size: 0.85rem;
    line-height: 1.9;
  }

  .copy {
    color: var(--ink-faint);
    font-size: 0.85rem;
    margin-block-start: 0.8rem;
  }
</style>
