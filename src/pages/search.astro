---
// صفحهٔ جستجوی سایت‌گرد — ایندکس از /search.json خوانده و در مرورگر فیلتر می‌شود
import Base from '../layouts/Base.astro';
import { SITE } from '../config';
---

<Base title={`جستجو — ${SITE.name}`} description="جستجو در همهٔ یادداشت‌های دفترچهٔ علمی">
  <section class="page container">
    <p class="kicker">در همهٔ بخش‌ها</p>
    <h1>جستجو</h1>

    <div class="bar suggest-wrap">
      <svg class="b-icon" viewBox="0 0 20 20" aria-hidden="true">
        <circle cx="9" cy="9" r="6" fill="none" stroke="currentColor" stroke-width="2" />
        <line x1="13.5" y1="13.5" x2="18" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
      <input
        id="q"
        type="search"
        data-suggest
        placeholder="مثلاً: ABRZ، بلیچینگ، restorative cycle…"
        aria-label="عبارت جستجو"
        autocomplete="off"
        autofocus
      />
      <button id="clear" class="b-clear" type="button" aria-label="پاک‌کردن جستجو" hidden>×</button>
    </div>

    <div class="chips" id="chips" role="group" aria-label="فیلتر بخش">
      <button data-f="" class="chip on">همه</button>
      <button data-f="everyone" class="chip">برای همه</button>
      <button data-f="professionals" class="chip">دندان‌پزشکان</button>
      <button data-f="failsafe" class="chip">Failuresafe</button>
      <button data-f="abrz" class="chip">ABRZ</button>
      <button data-f="notebook" class="chip">دفترچهٔ یادگیری</button>
    </div>

    <p class="status" id="status">در حال آماده‌سازی…</p>
    <div id="results" class="results" aria-live="polite"></div>
  </section>
</Base>

<script>
  const input = document.getElementById('q') as HTMLInputElement;
  const status = document.getElementById('status') as HTMLElement;
  const box = document.getElementById('results') as HTMLElement;
  const chips = document.getElementById('chips') as HTMLElement;

  const COLORS: Record<string, string> = {
    everyone: '#17706e',
    professionals: '#1b4079',
    failsafe: '#1b4079',
    abrz: '#1b4079',
    notebook: '#6b4d7f',
    alphabet: '#0f3a4a',
  };

  // یکسان‌سازی: ی/ک عربی → فارسی، حذف نیم‌فاصله، حروف کوچک
  const norm = (s: string) =>
    s.replaceAll('ي', 'ی').replaceAll('ك', 'ک').replaceAll('\u200c', ' ').toLowerCase();

  const esc = (s: string) =>
    s.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');

  type Item = { t: string; d: string; k: string; c: string; u: string; dt: string; b: string };
  let index: Item[] | null = null;
  let filter = '';

  async function load(): Promise<Item[]> {
    if (index) return index;
    index = (await (await fetch('/search.json')).json()) as Item[];
    return index;
  }

  // الگوی جستجو: بین حروف کاربر، نیم‌فاصلهٔ اختیاری پذیرفته می‌شود
  function rxFor(qRaw: string): RegExp {
    const q = norm(qRaw);
    const parts = q.split('').map((c) => c.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));
    return new RegExp(parts.join('\u200c?'), 'g');
  }

  function snippet(b: string, rx: RegExp): string {
    rx.lastIndex = 0;
    const m = rx.exec(b);
    if (!m || m.index === undefined) return b.slice(0, 150) + '…';
    const s = Math.max(0, m.index - 55);
    return (s > 0 ? '…' : '') + b.slice(s, m.index + m[0].length + 85) + '…';
  }

  // برجسته‌سازی امن: اول escape، بعد نشانه‌گذاری
  function mark(text: string, q: string): string {
    const safe = esc(text);
    const rx = rxFor(q);
    return safe.replace(rx, (m) => `<mark>${m}</mark>`);
  }

  const faDate = (iso: string) =>
    new Intl.DateTimeFormat('fa-IR', { year: 'numeric', month: 'long', day: 'numeric' }).format(
      new Date(iso)
    );

  function render(items: { it: Item; sn?: string }[], heading: string, q = '') {
    status.textContent = heading;
    box.innerHTML = '';
    for (const { it, sn } of items) {
      const a = document.createElement('a');
      a.className = 'res';
      a.href = it.u;
      a.style.setProperty('--sec', COLORS[it.c] ?? '#1b4079');

      const dot = document.createElement('span');
      dot.className = 'dot';
      const wrap = document.createElement('div');

      const h = document.createElement('h3');
      h.innerHTML = q ? mark(it.t, q) : esc(it.t);

      const p1 = document.createElement('p');
      p1.className = 'sn';
      const raw = sn ?? it.d ?? '';
      if (raw) p1.innerHTML = q ? mark(raw, q) : esc(raw);
      else p1.remove();

      const p2 = document.createElement('p');
      p2.className = 'm';
      p2.textContent = `${it.k} · ${faDate(it.dt)}`;

      wrap.append(h);
      if (raw) wrap.append(p1);
      wrap.append(p2);
      a.append(dot, wrap);
      box.append(a);
    }
  }

  let timer: ReturnType<typeof setTimeout>;
  async function run() {
    const qRaw = input.value.trim();
    let items = await load();

    if (filter) items = items.filter((it) => it.c === filter);

    if (qRaw.length < 2) {
      const recent = [...items].sort((a, b) => b.dt.localeCompare(a.dt)).slice(0, 5);
      render(recent.map((it) => ({ it })), 'تازه‌ترین یادداشت‌ها — یا بالاتر بنویسید تا جستجو کنیم:');
      return;
    }

    const qn = norm(qRaw);
    const rx = rxFor(qRaw);
    const hits = items
      .map((it) => {
        const t = norm(it.t);
        const d = norm(it.d);
        const b = norm(it.b);
        let s = 0;
        if (t.includes(qn)) s += 6;
        if (d.includes(qn)) s += 3;
        if (b.includes(qn)) s += 1;
        return { it, s, sn: b.includes(qn) ? snippet(it.b, rxFor(qRaw)) : undefined };
      })
      .filter((x) => x.s > 0)
      .sort((a, b) => b.s - a.s)
      .slice(0, 30);

    if (hits.length === 0) {
      render([], `چیزی برای «${qRaw}» پیدا نشد.`);
    } else {
      render(hits, `${hits.length} نتیجه برای «${qRaw}»:`, qRaw);
    }
  }

  input.addEventListener('input', () => {
    clearTimeout(timer);
    timer = setTimeout(run, 180);
  });

  chips.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button.chip') as HTMLElement | null;
    if (!btn) return;
    chips.querySelectorAll('.chip').forEach((c) => c.classList.remove('on'));
    btn.classList.add('on');
    filter = btn.dataset.f ?? '';
    run().catch(() => (status.textContent = 'خطا در جستجو.'));
  });

  // میان‌بر: کلید «/» در هر جای سایت، جستجو را فوکوس می‌کند
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement !== input && !(document.activeElement instanceof HTMLInputElement)) {
      e.preventDefault();
      input.focus();
    }
  });

  // پرکردن اولیه از ?q= و اجرا
  const initial = new URLSearchParams(location.search).get('q');
  if (initial) input.value = initial;
  input.focus();
  input.select();

  // دکمهٔ پاک‌کردن
  const clearBtn = document.getElementById('clear') as HTMLButtonElement;
  const syncClear = () => {
    clearBtn.hidden = input.value.length === 0;
  };
  clearBtn.addEventListener('click', () => {
    input.value = '';
    syncClear();
    input.focus();
    run().catch(() => {});
  });
  input.addEventListener('input', syncClear);
  syncClear();

  run().catch(() => (status.textContent = 'خطا در بارگذاری ایندکس جستجو.'));
</script>

<script>
  import '../scripts/search-suggest';
</script>

<style>
  .page {
    padding-block-start: clamp(2.5rem, 7vh, 4rem);
    max-inline-size: 52rem;
  }

  h1 {
    font-size: clamp(1.9rem, 1.5rem + 2vw, 2.5rem);
    font-weight: 800;
    margin-block: 0.3rem 1.4rem;
  }

  .bar {
    position: relative;
  }

  .bar .b-icon {
    position: absolute;
    inset-inline-start: 1.15rem;
    top: 50%;
    translate: 0 -50%;
    inline-size: 1.25rem;
    block-size: 1.25rem;
    color: var(--ink-faint);
    pointer-events: none;
    transition: color 0.2s ease;
  }

  .bar input {
    inline-size: 100%;
    font: inherit;
    font-size: 1.12rem;
    color: var(--ink);
    background: var(--paper);
    border: 1.5px solid var(--line-strong);
    border-radius: 999px;
    padding-block: 0.75em;
    padding-inline: 3.2em 3.2em;
    outline: none;
    box-shadow: 0 2px 10px -6px rgba(28, 33, 43, 0.25);
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .bar input::placeholder {
    color: var(--ink-faint);
  }

  .bar input:focus {
    border-color: var(--accent);
    box-shadow:
      0 0 0 4px var(--accent-wash),
      0 4px 16px -8px rgba(27, 64, 121, 0.35);
  }

  .bar:focus-within .b-icon {
    color: var(--accent);
  }

  .b-clear {
    position: absolute;
    inset-inline-end: 0.8rem;
    top: 50%;
    translate: 0 -50%;
    inline-size: 1.8rem;
    block-size: 1.8rem;
    border: none;
    border-radius: 999px;
    background: var(--wash);
    color: var(--ink-soft);
    font-size: 1.05rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .b-clear:hover {
    background: var(--accent-wash);
    color: var(--accent);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-block-start: 0.9rem;
  }

  .chip {
    font: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--ink-soft);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.22em 1em;
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      color 0.2s ease,
      background 0.2s ease;
  }

  .chip:hover {
    border-color: var(--line-strong);
    color: var(--ink);
  }

  .chip.on {
    color: #fff;
    background: var(--accent);
    border-color: var(--accent);
  }

  .status {
    color: var(--ink-soft);
    font-size: 0.9rem;
    margin-block: 1.1rem 0.4rem;
  }

  .results {
    margin-block-start: 0.6rem;
  }

  .res {
    display: flex;
    gap: 0.8rem;
    padding-block: 1.1rem;
    text-decoration: none;
    border-block-start: 1px solid var(--line);
  }

  .res:first-child {
    border-block-start: none;
  }

  .res .dot {
    flex: none;
    inline-size: 0.6rem;
    block-size: 0.6rem;
    border-radius: 999px;
    background: var(--sec, var(--accent));
    margin-block-start: 0.65em;
  }

  .res h3 {
    font-size: 1.08rem;
    color: var(--ink);
    line-height: 1.7;
  }

  .res:hover h3 {
    color: var(--accent);
  }

  .res .sn {
    color: var(--ink-soft);
    font-size: 0.9rem;
    line-height: 1.9;
    margin-block-start: 0.2rem;
  }

  .res .m {
    color: var(--ink-faint);
    font-size: 0.8rem;
    margin-block-start: 0.35rem;
  }
</style>
