---
// صفحهٔ اصلی — چیدمان روزنامه‌ای: نوار تاریخ، یادداشت برجسته،
// ستون «در یک نگاه»، کارت‌های رنگی بخش‌ها و نوار پروژه‌ها
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE, SECTIONS } from '../config';
import { faDate, readingMinutes, toFa } from '../lib/format';

type AnyPost = Awaited<ReturnType<typeof getCollection<'notebook'>>>[number];

const colls = ['everyone', 'professionals', 'failsafe', 'abrz', 'notebook'] as const;
const all = (
  await Promise.all(colls.map((c) => getCollection(c, (p) => !p.data.draft)))
).flat();
const sorted = all.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// یادداشت برجسته: تازه‌ترین محتوای اصلی (نه دفترچه)
const featured = sorted.find((p) => p.collection !== 'notebook') ?? sorted[0];
// ستون «در یک نگاه»: چهار تیتر بعدی
const glance = sorted.filter((p) => p !== featured).slice(0, 4);

const secColor: Record<string, string> = {
  everyone: 'var(--sec-everyone)',
  professionals: 'var(--sec-professionals)',
  failsafe: 'var(--sec-professionals)',
  abrz: 'var(--sec-professionals)',
  notebook: 'var(--sec-notebook)',
};

const sectionLabel = (p: AnyPost) => {
  if (p.collection === 'notebook') return 'دفترچهٔ یادگیری';
  if (p.collection === 'failsafe') return 'Failuresafe';
  if (p.collection === 'abrz') return 'ABRZ';
  return SECTIONS[p.collection as 'everyone' | 'professionals'].title;
};

const hrefOf = (p: AnyPost) =>
  p.collection === 'notebook'
    ? `/notebook/${p.id}`
    : p.collection === 'failsafe'
      ? `/professionals/failsafe/${p.id}`
      : p.collection === 'abrz'
        ? `/professionals/abrz/${p.id}`
        : `/${p.collection}/${p.id}`;

const gates = [
  {
    id: 'everyone',
    href: SECTIONS.everyone.href,
    title: SECTIONS.everyone.title,
    color: 'var(--sec-everyone)',
    count: all.filter((p) => p.collection === 'everyone').length,
    text: 'اطلاعات علمی و قابل‌فهم دربارهٔ سلامت دهان و دندان — برای عموم مردم.',
  },
  {
    id: 'professionals',
    href: SECTIONS.professionals.href,
    title: SECTIONS.professionals.title,
    color: 'var(--sec-professionals)',
    count: all.filter((p) => ['professionals', 'failsafe', 'abrz'].includes(p.collection)).length,
    text: 'مقالات علمی، مرور literature و یادداشت‌های بالینی — با دو پروژهٔ پژوهشی در حال رشد.',
  },
  {
    id: 'notebook',
    href: '/notebook',
    title: 'دفترچهٔ یادگیری',
    color: 'var(--sec-notebook)',
    count: all.filter((p) => p.collection === 'notebook').length,
    text: 'پرسش‌های باز، اشتباه‌ها و درس‌ها، تأمل‌ها و ایده‌های خام — ثبتشده در حین یادگیری.',
  },
];

const minutes = featured ? readingMinutes(featured.body ?? '') : 0;
---

<Base title={`${SITE.name} — ${SITE.tagline}`}>
  <!-- نوار تاریخ به سبک روزنامه -->
  <div class="dateline">
    <div class="container inner">
      <span>امروز {faDate(new Date())}</span>
      <span class="mid">{SITE.tagline}</span>
      <span>{toFa(all.length)} یادداشت در {toFa(4)} بخش</span>
    </div>
  </div>

  <section class="container hero">
    <p class="kicker reveal">دفترچهٔ شخصی یادگیری</p>
    <h1 class="title reveal" style="--d:.06s">{SITE.name}</h1>
    <p class="lede reveal" style="--d:.12s">
      این‌جا دفترچهٔ یادگیری من است: مقاله‌هایی که می‌خوانم، پرسش‌های بازم،
      اشتباه‌ها و درس‌هایم — با جداشدنِ صریحِ «شواهد علمی» از «برداشت شخصی».
      این دفترچه اول برای رشد من است؛ نه تبلیغ و نه نمایش تخصص.
    </p>
  </section>

  {
    featured && (
      <section class="container front" aria-label="یادداشت برجسته و تیترها">
        <article class="featured reveal" style={`--sec:${secColor[featured.collection]};--d:.15s`}>
          <p class="kicker" style={`color:${secColor[featured.collection]}`}>
            {sectionLabel(featured)}
          </p>
          <h2 class="f-title">
            <a href={hrefOf(featured)}>{featured.data.title}</a>
          </h2>
          {featured.data.description && <p class="f-dek">{featured.data.description}</p>}
          <p class="meta">
            <time datetime={featured.data.pubDate.toISOString()}>
              {faDate(featured.data.pubDate)}
            </time>
            <span aria-hidden="true">·</span>
            <span>{toFa(minutes)} دقیقه مطالعه</span>
            <span class="read">
              <a href={hrefOf(featured)}>ادامهٔ یادداشت ←</a>
            </span>
          </p>
        </article>

        <aside class="glance reveal" aria-label="در یک نگاه" style="--d:.25s">
          <h2>در یک نگاه</h2>
          <ul>
            {
              glance.map((p) => (
                <li style={`--sec:${secColor[p.collection]}`}>
                  <a href={hrefOf(p)}>
                    <span class="dot" aria-hidden="true" />
                    <span class="g-title">{p.data.title}</span>
                    <span class="g-sec">{sectionLabel(p)}</span>
                  </a>
                </li>
              ))
            }
            {glance.length === 0 && <li class="empty">هنوز یادداشتی منتشر نشده است.</li>}
          </ul>
        </aside>
      </section>
    )
  }

  <section class="container gates" aria-label="بخش‌های سایت">
    {
      gates.map((g, i) => (
        <a class="gate reveal" href={g.href} style={`--sec:${g.color};--d:${0.1 + i * 0.12}s`}>
          {g.id === 'everyone' && (
            <svg class="scene" viewBox="0 0 240 110" aria-hidden="true">
              <circle cx="120" cy="55" r="44" fill="var(--sec)" opacity="0.08" />
              <g class="float">
                <path
                  d="M108 36c-7 0-11.6 3.8-11.6 10.1 0 5 1.7 8.4 3 13.5 1.3 5 2.1 13.4 4.6 16.8 0.9 1.4 2.9 1.4 3.6-0.2l1.5-5.7c0.7-1.7 2.8-1.7 3.4 0l1.5 5.7c0.7 1.6 2.7 1.6 3.6 0.2 2.5-3.4 3.3-11.8 4.6-16.8 1.3-5.1 3-8.5 3-13.5 0-6.3-4.6-10.1-11.6-10.1-2.9 0-3.9 0.9-5 0.9s-2.2-0.9-5-0.9z"
                  fill="none"
                  stroke="var(--sec)"
                  stroke-width="2.4"
                />
              </g>
              <g class="spark s1" fill="var(--sec)">
                <path d="M152 28l2.4 5.4 5.4 2.4-5.4 2.4-2.4 5.4-2.4-5.4-5.4-2.4 5.4-2.4z" />
              </g>
              <g class="spark s2" fill="var(--sec)">
                <path d="M84 66l1.9 4.3 4.3 1.9-4.3 1.9-1.9 4.3-1.9-4.3-4.3-1.9 4.3-1.9z" />
              </g>
            </svg>
          )}
          {g.id === 'professionals' && (
            <svg class="scene" viewBox="0 0 240 110" aria-hidden="true">
              <circle cx="120" cy="55" r="44" fill="var(--sec)" opacity="0.08" />
              <g class="float">
                <rect
                  x="94"
                  y="28"
                  width="52"
                  height="50"
                  rx="15"
                  fill="none"
                  stroke="var(--sec)"
                  stroke-width="2.4"
                />
                <rect
                  class="ring"
                  x="101"
                  y="35"
                  width="38"
                  height="36"
                  rx="11"
                  fill="none"
                  stroke="var(--sec)"
                  stroke-width="1.7"
                  stroke-dasharray="5 4"
                />
                <ellipse cx="120" cy="53" rx="9.5" ry="11.5" fill="var(--sec)" opacity="0.35" />
              </g>
            </svg>
          )}
          {g.id === 'notebook' && (
            <svg class="scene" viewBox="0 0 240 110" aria-hidden="true">
              <circle cx="120" cy="55" r="44" fill="var(--sec)" opacity="0.08" />
              <g class="float">
                <rect
                  x="86"
                  y="26"
                  width="68"
                  height="58"
                  rx="9"
                  fill="none"
                  stroke="var(--sec)"
                  stroke-width="2.4"
                />
                <line
                  x1="98"
                  y1="44"
                  x2="140"
                  y2="44"
                  stroke="var(--sec)"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  class="ln l1"
                  style="--len:42"
                />
                <line
                  x1="98"
                  y1="55"
                  x2="134"
                  y2="55"
                  stroke="var(--sec)"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  class="ln l2"
                  style="--len:36"
                />
                <line
                  x1="98"
                  y1="66"
                  x2="138"
                  y2="66"
                  stroke="var(--sec)"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  class="ln l3"
                  style="--len:40"
                />
                <circle class="tip t1" cx="146" cy="44" r="3" fill="var(--sec)" />
                <circle class="tip t2" cx="140" cy="55" r="3" fill="var(--sec)" />
                <circle class="tip t3" cx="144" cy="66" r="3" fill="var(--sec)" />
              </g>
            </svg>
          )}
          <p class="g-kicker">{g.title}</p>
          <p class="g-count">{toFa(g.count)} یادداشت</p>
          <p class="g-text">{g.text}</p>
          <span class="more">مشاهدهٔ بخش ←</span>
        </a>
      ))
    }
  </section>

  <section class="container projects reveal" aria-label="پروژه‌های پژوهشی" style="--d:.2s">
    <span class="p-label">پروژه‌های پژوهشی:</span>
    <a href={SECTIONS.failsafe.href}>Failuresafe</a>
    <span aria-hidden="true">·</span>
    <a href={SECTIONS.abrz.href}>ABRZ</a>
    <span class="p-hint">— مطالعهٔ مقاله‌به‌مقاله، با جدا شدن شواهد از برداشت شخصی</span>
  </section>
</Base>

<style>
  /* ── نوار تاریخ — با ته‌رنگ ملایم سه رنگ سایت ── */
  .dateline {
    border-block-end: 1px solid var(--line);
    background: linear-gradient(
      90deg,
      #ecf5f4 0%,
      var(--wash) 30%,
      #edf2fa 65%,
      #f2eef6 100%
    );
  }

  .dateline .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.3rem 1.5rem;
    padding-block: 0.45rem;
    font-size: 0.82rem;
    color: var(--ink-soft);
  }

  .dateline .mid {
    display: none;
  }

  @media (min-width: 48rem) {
    .dateline .mid {
      display: inline;
    }
  }

  /* ── معرفی ── */
  .hero {
    padding-block: clamp(2.5rem, 8vh, 4.5rem) 2.25rem;
  }

  .title {
    font-size: clamp(2.4rem, 1.7rem + 3.2vw, 3.6rem);
    font-weight: 800;
    margin-block: 0.35rem 1.1rem;
    letter-spacing: -0.01em;
    background: linear-gradient(
      100deg,
      var(--accent) 0%,
      var(--sec-everyone) 42%,
      var(--sec-notebook) 88%
    );
    background-size: 220% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: gradientShift 9s ease-in-out infinite;
  }

  .lede {
    font-size: 1.13rem;
    color: var(--ink-soft);
    max-inline-size: 38rem;
    line-height: 2.05;
  }

  /* ── برجسته + در یک نگاه ── */
  .front {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding-block-end: 3rem;
    align-items: start;
  }

  @media (min-width: 60rem) {
    .front {
      grid-template-columns: 2fr 1fr;
      gap: 3.5rem;
    }
  }

  .featured {
    background: var(--raised);
    border: 1px solid var(--line);
    border-block-start: 3px solid var(--sec, var(--accent));
    border-radius: var(--radius);
    padding: 1.9rem 2rem 1.6rem;
  }

  .f-title {
    font-size: clamp(1.5rem, 1.2rem + 1.5vw, 2.1rem);
    font-weight: 800;
    line-height: 1.6;
    margin-block: 0.2rem 0.9rem;
  }

  .f-title a {
    color: var(--ink);
    text-decoration: none;
  }

  .f-title a:hover {
    color: var(--sec, var(--accent));
  }

  .f-dek {
    color: var(--ink-soft);
    font-size: 1.05rem;
    line-height: 1.95;
    margin-block-end: 1.1rem;
  }

  .featured .read {
    margin-inline-start: auto;
  }

  .featured .meta {
    align-items: baseline;
  }

  .featured .read a {
    font-weight: 700;
    text-decoration: none;
  }

  /* ستون تیترها */
  .glance h2 {
    font-size: 1.02rem;
    padding-block-end: 0.55rem;
    border-block-end: 2px solid var(--line-strong);
  }

  .glance ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .glance li + li {
    border-block-start: 1px solid var(--line);
  }

  .glance a {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      'dot title'
      'dot sec';
    column-gap: 0.6rem;
    padding-block: 0.8rem;
    text-decoration: none;
  }

  .glance .dot {
    grid-area: dot;
    inline-size: 0.55rem;
    block-size: 0.55rem;
    border-radius: 999px;
    background: var(--sec, var(--accent));
    margin-block-start: 0.55em;
  }

  .glance .g-title {
    grid-area: title;
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.8;
  }

  .glance a:hover .g-title {
    color: var(--accent);
  }

  .glance .g-sec {
    grid-area: sec;
    color: var(--ink-faint);
    font-size: 0.78rem;
    margin-block-start: 0.15rem;
  }

  .glance .empty {
    color: var(--ink-faint);
    padding-block: 1.2rem;
    font-size: 0.9rem;
  }

  /* ── کارت بخش‌ها ── */
  .gates {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 1.25rem;
    padding-block-end: 2.5rem;
  }

  .gate {
    display: block;
    background: var(--raised);
    border: 1px solid var(--line);
    border-block-start: 3px solid var(--sec, var(--accent));
    border-radius: var(--radius);
    padding: 1.4rem 1.6rem;
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .gate:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--sec) 55%, var(--line));
    box-shadow: 0 14px 36px -18px color-mix(in srgb, var(--sec) 50%, transparent);
  }

  .gate .more {
    transition: transform 0.2s ease;
  }

  .gate:hover .more {
    transform: translateX(-4px);
  }

  .g-kicker {
    color: var(--sec, var(--accent));
    font-weight: 800;
    font-size: 1.08rem;
    margin-block: 0 0.15rem;
  }

  .g-count {
    color: var(--ink-faint);
    font-size: 0.8rem;
    margin-block-end: 0.7rem;
  }

  .g-text {
    color: var(--ink-soft);
    font-size: 0.92rem;
    line-height: 1.9;
  }

  .gate .more {
    display: inline-block;
    margin-block-start: 1rem;
    color: var(--sec, var(--accent));
    font-weight: 700;
    font-size: 0.9rem;
  }

  /* ── نوار پروژه‌ها ── */
  .projects {
    border-block: 1px solid var(--line);
    padding-block: 0.9rem;
    margin-block-end: 3rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.8rem;
    font-size: 0.95rem;
  }

  .p-label {
    color: var(--ink-soft);
  }

  .projects a {
    font-weight: 800;
    text-decoration: none;
    letter-spacing: 0.01em;
  }

  .p-hint {
    color: var(--ink-faint);
    font-size: 0.85rem;
  }
</style>
