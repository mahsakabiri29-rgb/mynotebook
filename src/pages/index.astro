---
// صفحهٔ اصلی: فلسفهٔ دفترچه + در ورودی بخش‌ها + تازه‌ترین یادداشت‌ها
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { SITE, SECTIONS } from '../config';

// تازه‌ترین‌ها از هر چهار مجموعه، ترکیبی
const all = (
  await Promise.all([
    getCollection('everyone', (p) => !p.data.draft),
    getCollection('professionals', (p) => !p.data.draft),
    getCollection('failsafe', (p) => !p.data.draft),
    getCollection('abrz', (p) => !p.data.draft),
    getCollection('notebook', (p) => !p.data.draft),
  ])
).flat();
const latest = all
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---

<Base title={`${SITE.name} — ${SITE.tagline}`}>
  <section class="hero container">
    <p class="kicker">دفترچهٔ شخصی یادگیری</p>
    <h1 class="title">{SITE.name}</h1>
    <p class="lede">
      اینجا دفترچهٔ یادگیری من است: مقاله‌هایی که می‌خوانم، پرسش‌های بازم،
      اشتباه‌ها و درس‌هایم — با جداشدنِ صریحِ «شواهد علمی» از «برداشت شخصی».
      این دفترچه اول برای رشد من است؛ نه تبلیغ و نه نمایش تخصص.
    </p>
  </section>

  <section class="container gates" aria-label="بخش‌های سایت">
    <a class="gate" href={SECTIONS.everyone.href}>
      <h2>{SECTIONS.everyone.title}</h2>
      <p>{SECTIONS.everyone.intro}</p>
      <span class="more">مشاهدهٔ یادداشت‌ها ←</span>
    </a>
    <a class="gate" href={SECTIONS.professionals.href}>
      <h2>{SECTIONS.professionals.title}</h2>
      <p>
        مقالات علمی، مرور ادبیات و یادداشت‌های بالینی — از جمله پروژهٔ پژوهشی
        Failsafe دربارهٔ برنامه‌ریزی برای شکست درمان.
      </p>
      <span class="more">مشاهدهٔ یادداشت‌ها ←</span>
    </a>
    <a class="gate" href="/notebook">
      <h2>دفترچهٔ یادگیری</h2>
      <p>
        یادداشت‌های کوتاه: پرسش‌های باز، اشتباه‌ها و درس‌ها، تأمل‌ها و ایده‌های
        خام — ثبتشده در حین یادگیری.
      </p>
      <span class="more">مشاهدهٔ دفترچه ←</span>
    </a>
  </section>

  <section class="container latest" aria-label="تازه‌ترین یادداشت‌ها">
    <h2>تازه‌ترین یادداشت‌ها</h2>
    <div class="list">
      {latest.map((post) => <ArticleCard post={post} />)}
      {latest.length === 0 && <p class="empty">هنوز یادداشتی منتشر نشده است.</p>}
    </div>
  </section>
</Base>

<style>
  /* ── معرفی ── */
  .hero {
    padding-block: clamp(4rem, 12vh, 6.5rem) 3.25rem;
  }

  .title {
    font-size: clamp(2.3rem, 1.7rem + 3vw, 3.5rem);
    font-weight: 800;
    margin-block: 0.4rem 1.25rem;
  }

  .lede {
    font-size: 1.15rem;
    color: var(--ink-soft);
    max-inline-size: 36rem;
    line-height: 2.05;
  }

  /* ── در ورودی بخش‌ها ── */
  .gates {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1.25rem;
    padding-block-end: 4rem;
  }

  .gate {
    display: block;
    background: var(--raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.7rem 1.8rem;
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .gate:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
    box-shadow: 0 12px 32px -20px rgba(28, 33, 43, 0.4);
  }

  .gate h2 {
    font-size: 1.25rem;
    margin-block-end: 0.6rem;
    color: var(--ink);
  }

  .gate p {
    color: var(--ink-soft);
    font-size: 0.93rem;
    line-height: 1.9;
  }

  .more {
    display: inline-block;
    margin-block-start: 1.1rem;
    color: var(--accent);
    font-weight: 600;
    font-size: 0.92rem;
  }

  .gate:hover .more {
    color: var(--accent-deep);
  }

  /* ── تازه‌ترین‌ها ── */
  .latest {
    border-block-start: 1px solid var(--line);
    padding-block: 3rem 2rem;
  }

  .latest h2 {
    font-size: 1.25rem;
    padding-block-end: 0.9rem;
    border-block-end: 2px solid var(--line-strong);
  }

  .latest .list {
    margin-block-start: 0.25rem;
  }

  .empty {
    color: var(--ink-faint);
    padding-block: 2rem;
  }
</style>
