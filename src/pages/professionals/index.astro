---
// فهرست یادداشت‌های بخش «برای دندان‌پزشکان» + کارت پروژه‌های پژوهشی
import Base from '../../layouts/Base.astro';
import SectionIndex from '../../components/SectionIndex.astro';
import { SITE, SECTIONS } from '../../config';

const meta = SECTIONS.professionals;
const projects = [SECTIONS.failsafe, SECTIONS.abrz, SECTIONS.alphabet];

const projectText: Record<string, string> = {
  failsafe: 'برنامه‌ریزی برای شکست درمان و درمان‌های ترمیم‌پذیر — مقاله‌به‌مقاله.',
  abrz: 'ناحیهٔ مقاوم به اسید-باز در سطح چسبندگی ترمیم‌های چسبنده — مقاله‌به‌مقاله.',
  alphabet: 'The Alphabet of Adhesive Dentistry — مسیر یادگیری فصل‌به‌فصل با تحلیل انتقادی مقاله‌ها.',
};
---

<Base title={`${meta.title} — ${SITE.name}`} description={meta.description}>
  <SectionIndex section="professionals">
    <div class="project-grid" slot="lead">
      {
        projects.map((p) => (
          <a class="project" href={p.href}>
            <p class="project-kicker">{p.kicker}</p>
            <h2>پروژهٔ {p.title}</h2>
            <p>{projectText[p.slug]}</p>
            <span class="project-more">ورود به پروژه ←</span>
          </a>
        ))
      }
    </div>
  </SectionIndex>
</Base>

<style>
  .project-grid {
    margin-block-start: 2.25rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1rem;
  }

  .project {
    display: block;
    background: var(--accent-wash);
    border: 1px solid #c7d6ee;
    border-radius: var(--radius);
    padding: 1.4rem 1.6rem;
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .project:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .project-kicker {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--accent);
    margin-block: 0 0.3rem;
  }

  .project h2 {
    font-size: 1.15rem;
    margin-block-end: 0.4rem;
  }

  .project p {
    color: var(--ink-soft);
    font-size: 0.9rem;
    line-height: 1.9;
  }

  .project-more {
    display: inline-block;
    margin-block-start: 0.8rem;
    color: var(--accent);
    font-weight: 700;
    font-size: 0.9rem;
  }

  .project:hover .project-more {
    color: var(--accent-deep);
  }
</style>
