---
// صفحهٔ پروژهٔ ABRZ (داخل بخش «برای دندان‌پزشکان»): معرفی ایده + فهرست یادداشت‌ها
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { SITE, SECTIONS } from '../../../config';

const meta = SECTIONS.abrz;
const posts = (await getCollection('abrz', (p) => !p.data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Base title={`${meta.title} — ${SITE.name}`} description={meta.description}>
  <section class="section-page container">
    <header class="head">
      <p class="kicker">{meta.kicker}</p>
      <h1>{meta.title}</h1>
      <p class="intro">{meta.intro}</p>
    </header>

    <div class="list">
      <h2 class="list-title">یادداشت‌های این پروژه</h2>
      {posts.map((post) => <ArticleCard post={post} />)}
      {posts.length === 0 && <p class="empty">هنوز یادداشتی در این پروژه منتشر نشده است.</p>}
    </div>
  </section>
</Base>

<style>
  .section-page {
    max-inline-size: 58rem;
    padding-block-start: clamp(3rem, 8vh, 4.5rem);
  }

  .head h1 {
    font-size: clamp(2rem, 1.5rem + 2.4vw, 2.9rem);
    font-weight: 800;
    margin-block-end: 0.9rem;
  }

  .intro {
    color: var(--ink-soft);
    max-inline-size: 40rem;
    font-size: 1.05rem;
  }

  .list {
    margin-block-start: 2.5rem;
    padding-block-end: 3rem;
  }

  .list-title {
    font-size: 1.15rem;
    padding-block-end: 0.7rem;
    border-block-end: 2px solid var(--line-strong);
  }

  .empty {
    color: var(--ink-faint);
    padding-block: 2rem;
  }
</style>
