---
// صفحهٔ «درباره» — زندگی‌نامهٔ شما
// متن این صفحه نمونه است؛ آن را با اطلاعات واقعی خودتان جایگزین کنید.
import Base from '../layouts/Base.astro';
import { SITE } from '../config';
---

<Base title={`درباره — ${SITE.name}`} description="دربارهٔ نویسندهٔ این مجله و انگیزهٔ ساخت آن">
  <section class="page container">
    <header class="head">
      <p class="kicker">پشت‌صحنهٔ مجله</p>
      <h1>درباره</h1>
    </header>

    <div class="prose narrow">
      <!-- ✏️ از اینجا به بعد، متن را با اطلاعات خودتان عوض کنید -->
      <p>
        سلام! من «نام شما» هستم؛ دندان‌پزشک و نویسندهٔ این مجلهٔ کوچک.
        سال‌هاست هر روز میان دو دنیا رفت‌وآمد می‌کنم: دنیای مطب، که در آن با
        ترس‌ها و پرسش‌های بیماران روبه‌رو هستم، و دنیای مقاله‌ها و مجله‌های
        علمی، که در آن شواهد تازه‌ای برای پاسخ‌دادن به همان پرسش‌ها پیدا می‌شود.
      </p>
      <p>
        این مجله تلاشی برای پل‌زدن روی فاصلهٔ این دو دنیاست: در بخش
        <a href="/patients">«برای بیماران»</a> می‌کوشم دانش دندان‌پزشکی را به
        زبان ساده و قابل‌اعتماد بنویسم، و در بخش
        <a href="/professionals">«برای دندان‌پزشکان»</a>
        یادداشت‌هایی از مطالعهٔ ادبیات پژوهشی و تجربه‌های بالینی خودم نگه می‌دارم.
      </p>
      <blockquote>
        <p>
          اگر این متن را می‌خوانید، یعنی هنوز صفحهٔ «درباره» را ویرایش نکرده‌ام!
          این پاراگراف نمونه است؛ آن را با چند خط دربارهٔ خودتان، تحصیلات‌تان و
          رویکرد حرفه‌ای‌تان جایگزین کنید.
        </p>
      </blockquote>
      <h2>راه ارتباطی</h2>
      <p>
        برای گفت‌وگو دربارهٔ مقاله‌ها، از راه [نشانی ایمیل یا شبکهٔ اجتماعی شما]
        با من در ارتباط باشید.
      </p>
    </div>
  </section>
</Base>

<style>
  .page {
    padding-block-start: clamp(3rem, 8vh, 4.5rem);
    padding-block-end: 3rem;
  }

  .head h1 {
    font-size: clamp(2rem, 1.5rem + 2.4vw, 2.9rem);
    font-weight: 800;
    margin-block-end: 1.5rem;
  }

  .narrow {
    max-inline-size: var(--prose);
  }
</style>
